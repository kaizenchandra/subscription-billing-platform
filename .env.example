# Copy to .env locally; never commit populated credentials.
BILLING_RAZORPAY_ENABLED=false
BILLING_RAZORPAY_KEY_ID=
BILLING_RAZORPAY_KEY_SECRET=
BILLING_RAZORPAY_WEBHOOK_SECRET=
BILLING_RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
BILLING_RAZORPAY_ACCOUNT_ID=

# Optional host ports; container-to-container endpoints remain unchanged.
BILLING_POSTGRES_PORT=5432
BILLING_BACKEND_PORT=8080
BILLING_FRONTEND_PORT=3000
BILLING_OBJECT_STORAGE_PORT=4566
